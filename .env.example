# Rentora Environment Variables Template
# Copy this file to .env and fill in the values

# Django Settings
SECRET_KEY=your-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DOMAIN_URL=http://127.0.0.1:8000

# Database (Supabase PostgreSQL)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=your-project-ref.pooler.supabase.com
DB_PORT=6543

# Stripe Keys (Get from dashboard.stripe.com/test/apikeys)
STRIPE_PUBLIC_KEY=your-stripe-public-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_CURRENCY=inr

# Email Settings (Resend - Recommended)
RESEND_API_KEY=your-resend-api-key
DEFAULT_FROM_EMAIL=Rentora <your-verified-email@domain.com>

# Alternative Email Settings (Gmail SMTP fallback)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-gmail@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Social Auth (Google Console)
SOCIAL_AUTH_GOOGLE_CLIENT_ID=your-google-client-id
SOCIAL_AUTH_GOOGLE_SECRET=your-google-secret

# PWA / VAPID Keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_ADMIN_EMAIL=your-email@domain.com

# External APIs
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Monitoring (Sentry)
SENTRY_DSN=your-sentry-dsn
SENTRY_ENV=development

# Twilio (OTP/WhatsApp)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-sid

# Cloud Storage (Supabase S3)
AWS_ACCESS_KEY_ID=your-s3-access-key
AWS_SECRET_ACCESS_KEY=your-s3-secret-key
AWS_S3_ENDPOINT_URL=https://your-project-ref.storage.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=ap-south-1
AWS_STORAGE_BUCKET_NAME=rentora-media
